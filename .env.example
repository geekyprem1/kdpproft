# ─────────────────────────────────────────────────────────────
# KDP Pocket AI — environment surface
# Phase 0 documents the full surface. Only the PDF engine gate is
# wired up right now; the rest are placeholders for later phases.
# ─────────────────────────────────────────────────────────────

# --- Supabase (Phase 0 foundation: auth + db) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PDF storage ---
# MVP uses Supabase Storage (private "books" bucket) — no extra config needed
# beyond the Supabase keys above. Optionally override the bucket name:
SUPABASE_STORAGE_BUCKET=books

# Cloudflare R2 (LATER — switch when scaling; one-line change in lib/storage/index.ts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- OpenRouter (AI: custom word lists + KDP metadata) ---
# Optional: without a key the app falls back to curated word banks + template
# metadata, so the core flow still works. With a key, any niche works.
# Primary:  google/gemini-2.5-flash
# Fallback: deepseek/deepseek-v4-flash   (confirm exact slug in OpenRouter catalog)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_SITE_URL=http://localhost:3000

# --- Public site URL (auth email redirects) ---
# Used as the base for Supabase magic-link and OAuth callback URLs so emails
# always point at production even if the user starts the flow from another origin.
# MUST start with https:// in production. Example:
NEXT_PUBLIC_SITE_URL=https://kdpmafia.online

# --- Replicate (AI line art for Coloring Books — FLUX Schnell) ---
# Without it, coloring generation falls back to offline placeholder art.
REPLICATE_API_TOKEN=

# --- SiliconFlow (Story Book — FLUX.1 Kontext dev, reference-conditioned) ---
# Preferred backend for the storybook character-consistency pipeline: one locked
# reference image is fed into every page so the SAME character appears throughout.
# ~$0.015/image, cheaper than Replicate's kontext. When set, `npm run story:poc`
# uses SiliconFlow; otherwise it falls back to REPLICATE_API_TOKEN.
SILICONFLOW_API_KEY=
# Optional overrides (defaults shown):
# STORY_SF_KONTEXT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# STORY_SF_REFERENCE_MODEL=black-forest-labs/FLUX.1-schnell
# STORY_SF_IMAGE_SIZE=1024x1024
# STORY_SF_TIMEOUT_MS=120000   # per-image request timeout (hung connections retry)
# STORY_TEST_PAGES=7           # DEV ONLY: cap illustrated pages for fast previews (not KDP-ready)
# Vision model for the character-consistency judge (must be multimodal — GLM/DeepSeek
# text models reject image input). Defaults to google/gemini-2.5-flash via OpenRouter.
# STORY_VISION_MODEL=google/gemini-2.5-flash

# --- Cloudflare Workers AI (Cover Generator V2 — Beta) ---
# V2 lets the image model compose the whole cover, typography included. Both
# values come from the Cloudflare dashboard; the token needs Workers AI run
# permission only. Leave blank to keep V2 disabled.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Beta gate. Unset/0 = V2 route returns 403 and its nav entry stays hidden.
COVER_V2_ENABLED=
# GPT Image 2 (Replicate, paid) quality tier: low | medium | high. "low" is ~$0.01
# per image; higher tiers cost several times more. Only affects that one model.
COVER_V2_GPT_IMAGE_QUALITY=low
# Render model. Measured on the live account: klein-9b takes ~7s per cover but
# misspelled the title in 1 of 2 runs; flux-2-dev spelled 4 of 4 correctly but takes
# 150-200s per cover. klein-9b is the default because the repair loop and hybrid
# fallback catch its mistakes, and speed matters more for an interactive Beta.
# Set this to @cf/black-forest-labs/flux-2-dev to prefer first-pass accuracy.
COVER_V2_MODEL=@cf/black-forest-labs/flux-2-klein-9b
COVER_V2_DRAFT_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# Vision model that reads the rendered cover back to verify the text is spelled
# correctly before the user ever sees it. llama-4-scout is verified working;
# moondream3.1 returns empty results and llama-3.2-11b-vision needs a model
# agreement accepted on the Cloudflare account first.
COVER_V2_VERIFY_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# Concepts per generation (2 keeps Beta cost down, 3 matches V1).
COVER_V2_CONCEPTS=3

# --- Background job worker (optional — `npm run worker` for restart resilience) ---
WORKER_POLL_MS=5000
WORKER_CONCURRENCY=2
WORKER_STALE_MIN=10

# --- Billing ---
# QA ONLY. When "1", /api/billing/activate simulates a paid plan activation so you
# can test gating/credits without a real payment. MUST be unset/0 in production —
# otherwise any logged-in user could self-grant a paid plan. Real activation must
# come from a verified payment-provider webhook.
BILLING_TEST_ACTIVATION=

# --- Payment providers (DEFERRED — wired in lib/billing/providers/) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Admin & Support Center ---
# Comma-separated founder emails that are ALWAYS treated as super_admin. On login
# these users are auto-promoted to super_admin in the DB (self-healing bootstrap),
# so a founder can always reach /admin without touching the database. Everyone
# else's role lives in profiles.role (user|admin|super_admin). Keep this short.
# Example: SUPER_ADMIN_EMAILS=founder@example.com,ops@example.com
SUPER_ADMIN_EMAILS=
